# Use Ollama locally (default), or select OpenAI if you have API credits.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Required only when LLM_PROVIDER=openai. Never commit an actual key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Used for local document retrieval.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
